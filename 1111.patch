+package leetcode
+
+import "sort"
+
+func threeSum(nums []int) [][]int {
+	if len(nums) < 3 {
+		return [][]int{}
+	}
+	sort.Ints(nums)
+	res := [][]int{}
+	n := len(nums)
+	for i := 0; i < n-2; i++ {
+		if i > 0 && nums[i] == nums[i-1] {
+			continue
+		}
+		j := i + 1
+		k := n - 1
+		for j < k {
+			sum := nums[j] + nums[k]
+			if sum+nums[i] == 0 {
+				res = append(res, []int{nums[i], nums[j], nums[k]})
+				j++
+				k--
+				for j < k && nums[j] == nums[j-1] {
+					j++
+				}
+				for j < k && nums[k] == nums[k+1] {
+					k--
+				}
+			} else if sum+nums[i] < 0 {
+				j++
+			} else {
+				k--
+			}
+		}
+	}
+	return res
+}
