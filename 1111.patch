+package leetcode
+
+func searchMatrix(matrix [][]int, target int) bool {
+	n := len(matrix)
+	m := len(matrix[0])
+	if n == 0 || m == 0 {
+		return false
+	}
+	row, col := 0, m-1
+	for row < n && col >= 0 {
+		if matrix[row][col] == target {
+			return true
+		}
+		if matrix[row][col] > target {
+			col--
+		} else {
+			row++
+		}
+	}
+	return false
+}
